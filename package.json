{
  "name": "focusflow",
  "productName": "Azm",
  "version": "0.4.0",
  "description": "Azm (عَزم) — a calm focus timer, task manager and study planner",
  "main": "./out/main/index.js",
  "author": "Azm",
  "homepage": "https://github.com/LokmanBrahmia/FocusFlow",
  "repository": {
    "type": "git",
    "url": "https://github.com/LokmanBrahmia/FocusFlow.git"
  },
  "private": true,
  "desktopName": "focusflow.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:linux": "npm run build && node scripts/package.mjs --linux --x64 --publish never",
    "dist:win": "npm run build && node scripts/package.mjs --win --x64 --publish never",
    "dist:mac": "npm run build && node scripts/package.mjs --mac --publish never",
    "test:e2e": "electron-vite build && playwright test",
    "dist:appimage": "npm run build && node scripts/package.mjs --linux AppImage --x64 --publish never",
    "dist:dir": "npm run build && node scripts/package.mjs --dir --publish never",
    "verify:native": "node scripts/verify-native.mjs",
    "release:check": "node scripts/check-release-version.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@lucide/vue": "^1.80.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.7",
    "@vitejs/plugin-vue": "^6.0.11",
    "echarts": "^6.1.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1",
    "vue-tsc": "^3.3.14"
  }
}
